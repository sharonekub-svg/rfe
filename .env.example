# Copy this file to ".env" and fill in your real values.
# .env is git-ignored — never commit real keys.

# --- Alpaca (PAPER trading only) ---
ALPACA_API_KEY_ID=your_key_id_here
ALPACA_API_SECRET_KEY=your_secret_here
# Must be the PAPER endpoint. The app refuses to trade against a live endpoint.
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_DATA_URL=https://data.alpaca.markets/v2

# --- CapitalTrades source ---
CAPITALTRADES_BASE_URL=https://bff.capitaltrades.com

# --- Strategy settings ---
# How many of the most-active politicians to consider for ranking.
RANK_UNIVERSE_SIZE=40
# Minimum number of disclosed trades in the trailing window to be "active".
MIN_TRADES_12M=8
# How many top-ranked politicians to mirror. Capital is split equally across
# them and diversified across their positions (1 = follow only the leader).
TOP_N_LEADERS=3
# Fraction of account equity to deploy across the mirrored portfolio (0-1).
DEPLOY_FRACTION=0.80
# Max fraction of equity in any single position (0-1).
MAX_POSITION_FRACTION=0.15
# Set to "true" to compute & email but place NO orders.
DRY_RUN=true

# --- Email summary (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
# For Gmail use an App Password (not your normal password).
SMTP_PASSWORD=your_app_password
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
